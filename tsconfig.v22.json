{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "verbatimModuleSyntax": true
  },
  "include": [
    ".opencode/smart-router/**/*.ts",
    ".opencode/plugins/*.ts",
    "tests/smart-router/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/smart-router/agent-threading.test.ts",
    // The TUI plugin needs @opencode-ai/plugin/tui, solid-js and @opentui/solid.
    // Those live in .opencode/node_modules, which is gitignored and never
    // installed by `npm ci`, so a clean checkout cannot typecheck it. It is a
    // host-side UI extension, not part of the app build or the test suite.
    ".opencode/plugins/smart-router-tui.tsx"
  ]
}
